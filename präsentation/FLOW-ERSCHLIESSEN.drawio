  <diagram name="Inhalt erschließen" id="curation-flow">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1508" math="0" shadow="0">
      <root>
