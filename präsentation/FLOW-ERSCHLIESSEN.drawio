        <mxCell id="title" value="„Inhalt erschließen“ — welche Screens erscheinen" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#123359;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Derselbe Weg in beiden Kontexten. Die Kästen tragen die Titel, unter denen der Screen im Panel steht." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5b616b;" vertex="1" parent="1"><mxGeometry x="60" y="72" width="1300" height="24" as="geometry"/></mxCell>
