        <mxCell id="lgt2" value="Schritt entfällt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1b1b1f;" vertex="1" parent="1"><mxGeometry x="636" y="108" width="152" height="18" as="geometry"/></mxCell>
        <mxCell id="head60" value="&lt;b&gt;Core-Repository&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4e89;fontSize=15;fontColor=#123359;align=center;spacingLeft=0;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="460" height="40" as="geometry"/></mxCell>
        <mxCell id="head580" value="&lt;b&gt;WLO-Kontext&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4e89;fontSize=15;fontColor=#123359;align=center;spacingLeft=0;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="460" height="40" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;Hauptmenü&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Der Eintrag „Inhalt erschließen“ wird angetippt — nichts öffnet sich von selbst.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontColor=#123359;align=center;spacingLeft=0;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="216" width="980" height="63" as="geometry"/></mxCell>
        <mxCell id="core0" value="&lt;b&gt;Anmelden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Zugangsdaten für das Repository.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="323" width="460" height="63" as="geometry"/></mxCell>
        <mxCell id="wlo0" value="&lt;i&gt;&lt;b&gt;Anmelden entfällt&lt;/b&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Kein Login-Screen: die Sitzung bringt die Umgebung mit.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#b4bac2;fontSize=14;fontColor=#5b616b;align=left;spacingLeft=10;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="636" y="323" width="404" height="63" as="geometry"/></mxCell>
        <mxCell id="core1" value="&lt;b&gt;Inhalt erschließen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Die geöffnete Seite wird gelesen. Ein Fortschrittsbild läuft,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;bis die Metadaten da sind.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo1" value="&lt;b&gt;Inhalt erschließen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Die geöffnete Seite wird gelesen. Ein Fortschrittsbild läuft,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;bis die Metadaten da sind.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="430" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="core2" value="&lt;b&gt;Inhalt erschließen · Vorschau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Vorschaubild und Titel prüfen.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;„Weiter“ legt den Inhalt an.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="553" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo2" value="&lt;b&gt;Inhalt erschließen · Vorschau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Vorschaubild und Titel prüfen.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;„Weiter“ legt den Inhalt an.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="553" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="core3" value="&lt;b&gt;An Redaktionen weiterleiten&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Nur die Zeile für das Nostr-Relay —&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Redaktionen gibt es hier nicht.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo3" value="&lt;b&gt;An Redaktionen weiterleiten&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Redaktionen ankreuzen, darunter die&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Relay-Zeile. Ein Team mit Unter-&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;sammlungen führt einen Schritt weiter.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="676" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="branch3" value="&lt;b&gt;Sammlung auswählen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Die Sammlung innerhalb des gewählten&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Teams. „Sammlung übernehmen“ führt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;zurück in die Liste.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="676" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="core4" value="&lt;b&gt;Persönliche Ablage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Ordner der eigenen Ablage, dazu&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;wahlweise eine Sammlung.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="815" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo4" value="&lt;b&gt;Persönliche Ablage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Gleicher Screen — aber nur mit eigenem&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Login. Mit der mitgebrachten Sitzung&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;entfällt der Schritt.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="815" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="core5" value="&lt;i&gt;&lt;b&gt;Prüfprozess entfällt&lt;/b&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Es gibt nur einen Weg; die Metadaten&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;folgen direkt.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#b4bac2;fontSize=14;fontColor=#5b616b;align=left;spacingLeft=10;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="116" y="954" width="404" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo5" value="&lt;b&gt;Prüfprozess auswählen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Zwei Karten zur Wahl: strukturierte&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Prüfung oder Prüfung mit KI.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="954" width="460" height="79" as="geometry"/></mxCell>
        <mxCell id="core6" value="&lt;i&gt;&lt;b&gt;Qualität entfällt&lt;/b&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Die Kriterien-Ansicht gibt es in&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;diesem Kontext nicht.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#b4bac2;fontSize=14;fontColor=#5b616b;align=left;spacingLeft=10;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="116" y="1077" width="404" height="79" as="geometry"/></mxCell>
        <mxCell id="wlo6" value="&lt;b&gt;Qualitätsprüfung · Qualität&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Kriterien beantworten. Erst wenn sie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;erfüllt sind, öffnet sich der zweite&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Reiter.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1077" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="branch6" value="&lt;b&gt;Individuelle Qualitätsprüfung mit KI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Der andere Weg: ein Gespräch mit dem&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Assistenten über den Inhalt.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;„Abschließen und zur Inhaltsübersicht“.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="1077" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="core7" value="&lt;b&gt;Qualitätsprüfung · Metadaten&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Das Formular des Repositorys — der&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;einzige Reiter des Schritts.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;„Weiter“ speichert.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1216" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="wlo7" value="&lt;b&gt;Qualitätsprüfung · Metadaten&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Das WLO-Formular, zweiter Reiter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;nach der Qualität.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;„Weiter“ speichert.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1216" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="core8" value="&lt;b&gt;Inhaltsübersicht&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Vorschau · Nutzung · Inhalt teilen ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Interaktionen. Interaktionen zeigt nur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;den Stand beim Nostr-Relay.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1355" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="wlo8" value="&lt;b&gt;Inhaltsübersicht&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Dieselben vier Reiter. Interaktionen&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;zeigt zusätzlich eine Karte je&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5b616b&quot;&gt;Redaktion.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#1b1b1f;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1355" width="460" height="95" as="geometry"/></mxCell>
