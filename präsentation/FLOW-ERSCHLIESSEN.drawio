        <mxCell id="lgt0" value="in beiden Kontexten gleich" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1b1b1f;" vertex="1" parent="1"><mxGeometry x="92" y="108" width="232" height="18" as="geometry"/></mxCell>
