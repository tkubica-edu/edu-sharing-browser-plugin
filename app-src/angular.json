{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sidebar": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "es",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sidebar",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "theme-boot.js",
                "input": "src",
                "output": "."
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "scripts": [],
            "baseHref": "./",
            "outputHashing": "none",
            "allowedCommonJsDependencies": [
              "webextension-polyfill",
              "uuid"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "50kb"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "extractLicenses": false,
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "providersFile": "src/testing/test-providers.ts",
            "setupFiles": [
              "src/testing/extension-globals.setup.ts",
              "src/testing/color-scheme.setup.ts",
              "src/testing/quiet-logs.setup.ts",
              "src/testing/no-network.setup.ts"
            ],
            "include": [
              "src/**/*.spec.ts"
            ],
            "runnerConfig": "vitest.config.ts",
            "coverageInclude": [
              "src/app/services/**/*.ts",
              "src/app/util/**/*.ts",
              "src/app/model/navigation.ts",
              "src/app/pipes/**/*.ts",
              "src/app/config.ts",
              "src/app/features/**/*.ts",
              "src/app/template/**/*.ts",
              "src/app/shared/**/*.ts"
            ],
            "coverageExclude": [
              "src/testing/**",
              "**/*.spec.ts",
              "src/app/services/web-component-bundle.service.ts",
              "src/app/features/assistant/ai-assistant-screen/**",
              "src/app/features/quality/ai-quality-screen/**",
              "src/app/features/content/add-material-screen/**",
              "src/app/features/content/find-content-screen/**",
              "src/app/features/content/new-document-screen/**",
              "src/app/features/content/own-content-screen/**",
              "src/app/features/content/search-screen/**",
              "src/app/features/curation/curation-preview-screen/**",
              "src/app/features/filing/collection-selector/**",
              "src/app/features/filing/personal-storage-screen/**",
              "src/app/features/filing/select-collection-screen/**",
              "src/app/features/filing/storage-location-picker/**",
              "src/app/features/metadata/mds-editor/**",
              "src/app/features/metadata/mds-preview-widget/**",
              "src/app/features/metadata/metadata-screen/**",
              "src/app/features/metadata/wlo-canvas/**",
              "src/app/features/overview/preview-node/**",
              "src/app/features/overview/preview-screen/**",
              "src/app/features/overview/share-screen/**",
              "src/app/features/overview/share-teaser/**",
              "src/app/features/overview/usages-screen/**",
              "src/app/shared/components/nodes-selector/**"
            ],
            "coverageReporters": [
              "text-summary",
              "html",
              "lcovonly"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
