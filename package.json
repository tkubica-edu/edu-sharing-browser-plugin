{
  "name": "edu-sharing-extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Cross-browser (Chrome/Edge/Firefox/Safari) edu-sharing Erschließung extension with an Angular sidebar.",
  "scripts": {
    "install:app": "npm --prefix app-src install",
    "test": "npm --prefix app-src run test",
    "build": "npm run install:app && node scripts/build.mjs --target=all --exclude=wlo,boerdi",
    "build:chrome": "node scripts/build.mjs --target=chrome --exclude=wlo,boerdi",
    "build:firefox": "node scripts/build.mjs --target=firefox --exclude=wlo,boerdi",
    "build:safari": "node scripts/build.mjs --target=safari --exclude=wlo,boerdi",
    "build:no-ng": "node scripts/build.mjs --target=all --no-ng --exclude=wlo,boerdi",
    "dev:firefox": "node scripts/build.mjs --target=firefox --watch --run",
    "dev:chrome": "node scripts/build.mjs --target=chrome --watch",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "version:set": "node scripts/version.mjs",
    "test:coverage": "npm --prefix app-src run test:coverage"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "web-ext": "^8.3.0",
    "webextension-polyfill": "^0.12.0"
  }
}
