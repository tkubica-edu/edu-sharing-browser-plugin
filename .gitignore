node_modules/
dist/
app-src/node_modules/
app-src/dist/
app-src/.angular/
*.log
.DS_Store
# Claude's local state stays out; what the project shares — its skills and the permissions
# everyone works under — is tracked. Re-including needs the /* form: a file inside an ignored
# directory cannot be brought back.
.claude/*
!.claude/skills/
!.claude/settings.json
.agents
.idea

# The sidebar's built JavaScript: `main.js` plus whatever chunks the build splits off (a lazy
# import gets its own), and the pdf.js worker the build copies in beside them. index.html and
# styles.css are tracked — they are what the manifest points at.
sidebar/*.js
sidebar/*.mjs